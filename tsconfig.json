{
  "extends": "expo/tsconfig.base",
  "compilerOptions": {
    "strict": true,
    // Indexing into an array or Record yields `T | undefined`. Verbose, but it is
    // the single highest-value flag for a data-driven app: it forces us to handle
    // the empty list / missing key cases that RLS-filtered queries produce.
    "noUncheckedIndexedAccess": true,
    "noFallthroughCasesInSwitch": true,
    "noImplicitOverride": true,
    "forceConsistentCasingInFileNames": true,
    "paths": {
      "@/*": ["./src/*"],
      "@/assets/*": ["./assets/*"]
    }
  },
  "include": ["**/*.ts", "**/*.tsx", ".expo/types/**/*.ts", "expo-env.d.ts", "app.config.ts"],
  "exclude": ["node_modules", "ios", "android", ".expo", "dist"]
}
