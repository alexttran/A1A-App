*.orig.*

# Native projects are generated by `expo prebuild` (Continuous Native
# Generation). Everything that would be hand-edited there lives in
# app.config.ts and config plugins instead. Remove these two lines if the
# project ever adopts a checked-in native workflow.
/ios
/android

