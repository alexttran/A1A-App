# A1A Field App — environment variables
#
# Copy this file to `.env` and fill in the real values from your Supabase and
# Sentry dashboards. `.env` is git-ignored and must never be committed.
#
# All values below are read in `app.config.ts` and end up in the app bundle via
# `extra`. Anything you add here is PUBLIC. See the security block at the top of
# `app.config.ts` before adding a variable.
#
# The values shown are obviously-fake placeholders. Do not ship them.

# ---------------------------------------------------------------------------
# Supabase
# ---------------------------------------------------------------------------

# Project REST URL. Supabase dashboard → Project Settings → Data API → Project URL
SUPABASE_URL=https://REPLACE-WITH-YOUR-PROJECT-REF.supabase.co

# The *anon* (publishable) key. Supabase dashboard → Project Settings → API Keys.
# Safe to ship in the client: it is RLS-scoped and grants nothing that row-level
# security does not already permit.
SUPABASE_ANON_KEY=REPLACE_WITH_YOUR_ANON_KEY

# !! NEVER add SUPABASE_SERVICE_ROLE_KEY to this file or to app.config.ts. !!
# It bypasses row-level security entirely. If server-side code needs it, set it
# as a Supabase Edge Function secret (`supabase secrets set`), not here.

# ---------------------------------------------------------------------------
# Sentry (added in Checkpoint 3)
# ---------------------------------------------------------------------------

# Client DSN. Public by design — it only permits writing events to the project.
SENTRY_DSN=https://0000000000000000000000000000dead@o000000.ingest.sentry.io/0000000

# ---------------------------------------------------------------------------
# Build variant
# ---------------------------------------------------------------------------

# One of: development | preview | production
# Controls the app name and bundle identifier so builds can coexist on a device.
# EAS sets this per build profile in eas.json; set it locally only if you need
# to reproduce a non-development build.
APP_VARIANT=development

# ---------------------------------------------------------------------------
# NOT stored in .env — these live in EAS / CI secrets only
# ---------------------------------------------------------------------------
#
#   SENTRY_AUTH_TOKEN  — uploads source maps during an EAS build.
#                        `eas secret:create --name SENTRY_AUTH_TOKEN --value ...`
#
#   SUPABASE_ACCESS_TOKEN — used by `npm run types:generate` against the hosted
#                        project. Export it in your shell, or log in once with
#                        `npx supabase login`.
